---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<Base title="Blog" description="Keyboard, switch and shortcut guides from Keyboard Cheat Codes.">
  <section class="hero" style="padding-bottom:10px">
    <div class="wrap" style="display:block">
      <span class="eyebrow">the blog</span>
      <h1>Guides</h1>
      <p class="lead">Every video, written up as a quick guide you can skim.</p>
    </div>
  </section>
  <section class="block">
    <div class="wrap"><div class="cards">{posts.map((p) => <PostCard post={p} />)}</div></div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';
import FreeSheetCTA from '../components/FreeSheetCTA.astro';
import gear from '../data/gear.json';

type Item = { id: string; name: string; kind: string; tier: string; why: string; program: string; link: string; affiliate: string };
const all: Item[] = gear.groups.flatMap((g) => g.items as Item[]);
const byId = new Map(all.map((i) => [i.id, i]));
const pickLabels = ['Budget', 'Best first mechanical', 'Office', 'Gaming', 'Premium'];
const picks = gear.picks.map((id, n) => ({ item: byId.get(id)!, label: pickLabels[n] }));
const hasAmazon = all.some((i) => i.affiliate.includes('amazon.'));
const href = (i: Item) => i.affiliate || i.link;
const rel = (i: Item) => (i.affiliate ? 'sponsored nofollow noopener' : 'nofollow noopener');
const tierName: Record<string, string> = { '$': 'under $70', '$$': '$70–150', '$$$': '$150+' };
const accent = ['var(--lime)', 'var(--yellow)', 'var(--orange)', 'var(--cyan)'];
---
<Base title="Keyboard Gear: Every Board, Switch and Desk Upgrade" description="Every keyboard from the Keyboard Cheat Codes videos, plus switches, keycaps and desk accessories, sorted by size and price.">
  <section class="hero" style="padding-bottom:10px"><div class="wrap" style="display:block">
    <span class="eyebrow">the gear list</span>
    <h1>Every keyboard, switch and desk upgrade from the videos</h1>
    <p class="lead" style="max-width:56ch">Sorted by size and price, with one line on who each one is for. Not sure where to start? Grab one of the five picks below.</p>
    <p class="disclosure"><strong>Heads up:</strong> some links on this page are affiliate links. If you buy through one, I may earn a small commission at no extra cost to you.{hasAmazon && ' As an Amazon Associate I earn from qualifying purchases.'} Prices change, so check the store for today's price.</p>
    <nav class="jump" aria-label="Jump to section">
      {gear.groups.map((g) => <a href={`#${g.id}`}>{g.title}</a>)}
    </nav>
  </div></section>

  <section class="block"><div class="wrap">
    <h2>Start here: one pick per budget</h2>
    <div class="picks">
      {picks.map(({ item, label }, n) => (
        <a class="pick" href={href(item)} rel={rel(item)} target="_blank" style={`--c:${['#9cff1d','#fed120','#3ddce2','#ff3230','#9540dc'][n]}`}>
          <span class="pick-label">{label}</span>
          <strong>{item.name}</strong>
          <span class="meta">{item.kind} · {item.tier}</span>
          <span class="why">{item.why}</span>
          <span class="go">Check price →</span>
        </a>
      ))}
    </div>
  </div></section>

  {gear.groups.map((g, gi) => (
    <section class="block" id={g.id}><div class="wrap">
      <h2>{g.title}</h2>
      <p class="group-intro">{g.intro}{g.video && <> <a href={g.video}>Watch the video guide →</a></>}</p>
      <div class="gear-grid">
        {(g.items as Item[]).map((i) => (
          <div class="gear-card" style={`--c:${accent[gi % accent.length]}`}>
            <div class="gear-top"><span class="kind">{i.kind}</span><span class="tier" title={tierName[i.tier]}>{i.tier}</span></div>
            <h3>{i.name}</h3>
            <p>{i.why}</p>
            <a class="btn alt small-btn" href={href(i)} rel={rel(i)} target="_blank">Check price</a>
          </div>
        ))}
      </div>
    </div></section>
  ))}

  <section class="block"><div class="wrap" style="display:grid;gap:22px">
    <p class="small" style="margin:0">Price key: $ under $70 · $$ $70–150 · $$$ over $150, roughly, in US dollars. Nothing here is sponsored: brands don't pay to be listed.</p>
    <FreeSheetCTA />
  </div></section>
</Base>

<style>
  .disclosure { margin: 18px 0 0; padding: 12px 16px; border: 2px dashed var(--ink); border-radius: 12px; background: var(--soft); font-size: 15px; max-width: 75ch; }
  .jump { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .jump a { font-family: var(--mono); font-size: 13px; text-transform: uppercase; letter-spacing: .08em; color: var(--ink); border: 2px solid var(--ink); border-radius: 999px; padding: 6px 12px; text-decoration: none; }
  .jump a:hover { background: var(--yellow); }
  .picks { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 16px; }
  .pick { display: flex; flex-direction: column; gap: 6px; padding: 16px; border: 2.5px solid var(--ink); border-radius: var(--radius); background: var(--paper); color: var(--ink); text-decoration: none; box-shadow: 5px 5px 0 var(--c); transition: transform .08s; }
  .pick:hover { color: var(--ink); transform: translate(-2px,-2px); }
  .pick strong { font-family: var(--display); font-size: 20px; line-height: 1.15; }
  .pick-label { align-self: flex-start; background: var(--c); border: 2px solid var(--ink); border-radius: 999px; padding: 2px 10px; font-weight: 800; font-size: 13px; }
  .pick .why { font-size: 14px; color: var(--muted); flex: 1; }
  .pick .go { font-weight: 800; }
  .group-intro { color: #2a2a2a; max-width: 65ch; margin: -6px 0 20px; }
  .gear-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 16px; }
  .gear-card { border: 2.5px solid var(--ink); border-radius: var(--radius); padding: 14px 16px 16px; display: flex; flex-direction: column; gap: 6px; border-top: 10px solid var(--c); }
  .gear-card h3 { font-size: 19px; margin: 2px 0 0; }
  .gear-card p { margin: 0; color: var(--muted); font-size: 15px; flex: 1; }
  .gear-top { display: flex; justify-content: space-between; gap: 8px; }
  .kind { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); }
  .tier { font-weight: 800; }
  .small-btn { padding: 8px 14px; font-size: 14px; box-shadow: 3px 3px 0 var(--ink); align-self: flex-start; margin-top: 6px; }
</style>

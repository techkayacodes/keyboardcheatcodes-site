---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <article class="post narrow">
    <span class="meta">error 404</span>
    <h1>That key doesn't do anything.</h1>
    <p class="dek">The page you wanted isn't here. Press <kbd style="font-family:var(--mono)">Alt</kbd> + <kbd style="font-family:var(--mono)">←</kbd> to go back, or head <a href="/">home</a>.</p>
  </article>
</Base>

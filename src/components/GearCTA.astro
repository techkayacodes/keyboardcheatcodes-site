---
interface Props { title?: string; text?: string; }
const {
  title = 'The gear I point people to',
  text = 'Every keyboard from the videos, plus the switches, keycaps and desk upgrades worth buying, sorted by size and price.',
} = Astro.props;
---
<div class="offer gear-offer">
  <div>
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
  <a class="btn lime" href="/gear/">See the gear list</a>
</div>
